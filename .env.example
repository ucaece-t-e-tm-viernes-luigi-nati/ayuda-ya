# Copiá este archivo como .env.local y completá los valores. NUNCA subas .env.local a git (el repo es público).
# En Vercel: Settings → Environment Variables (las mismas claves).

# --- Base de datos (Neon) ---
DATABASE_URL="postgresql://usuario:clave@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# --- Sesiones (better-auth) ---
# Generala con:  npx @better-auth/cli secret   (o cualquier string aleatorio de 32+ caracteres)
BETTER_AUTH_SECRET=""
# En tu PC: http://localhost:3000. En Vercel ponés la URL de producción (o la dejás vacía y se calcula sola).
BETTER_AUTH_URL="http://localhost:3000"
# URL pública que va en los links de los mails (ej. https://ayudaya-lat.vercel.app).
APP_URL="http://localhost:3000"

# --- Superadmin (equipo AyudaYa) ---
# Emails habilitados como superadmin, separados por coma. Entran por la URL interna /plataforma/ingresar
# ("Primer ingreso" les manda un link de un solo uso para definir la contraseña).
SUPERADMIN_EMAILS="lorviz@ucaecemdp.edu.ar"
# Quiénes reciben los avisos de "Nueva solicitud de alta" y "Nuevo pedido" (si se deja vacío, se usa SUPERADMIN_EMAILS).
SUPERADMIN_NOTIFY_EMAILS="lorviz@ucaecemdp.edu.ar"

# --- Mails ---
# smtp = envío real con Gmail / Google Workspace (contraseña de aplicación).
# Cualquier otro valor (o vacío) = solo se guardan en email_outbox (visibles en /plataforma/mails).
MAIL_PROVIDER="smtp"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="lorviz@ucaecemdp.edu.ar"
# Contraseña de APLICACIÓN de Google (16 caracteres), no la contraseña normal de la cuenta.
SMTP_PASS=""
MAIL_FROM="AyudaYa <lorviz@ucaecemdp.edu.ar>"

# --- Asistente con IA (opcional) ---
# Clave de la API de Claude (solo servidor). Sin clave, el asistente usa la alternativa por palabras clave.
ANTHROPIC_API_KEY=""
# Modelo (opcional). Por defecto claude-sonnet-5-5.
ANTHROPIC_MODEL=""

# --- WhatsApp público de AyudaYa ---
# Formato internacional sin + ni espacios (ej. 5492235551234). Se ve en el navegador.
# Si queda vacío se usa un número de ejemplo (5492230000000).
NEXT_PUBLIC_WHATSAPP=""

# --- Cron de liquidaciones ---
# Vercel la manda como "Authorization: Bearer <CRON_SECRET>" al llamar /api/cron/vencimientos.
CRON_SECRET=""
# Días de gracia entre el vencimiento de la liquidación y la pausa automática (opcional, default 7).
PAUSE_AFTER_DAYS="7"

# --- Datos de demo ---
# true = en cada build carga 3 prestadores y 6 pedidos de ejemplo (idempotente). El tarifario se carga siempre.
SEED_DEMO="false"
